From a29991bd0db8e4d8c0f5ccb73313aa9c1ba43972 Mon Sep 17 00:00:00 2001
From: bmatusiak <bmatusiak@gmail.com>
Date: Thu, 22 Oct 2026 18:08:23 -0400
Subject: [PATCH 1/2] fido2: serve the same chunk again for a repeated poll

Windows sends every FIDO2 request twice and keeps the second answer. A large
response is read with OKPING polls whose opt3 is 0, which the opt3 duplicate check
cannot see, so each copy advanced the cursor and the host lost every other chunk
of a reply longer than one (an X-Wing public key from the web app on Windows).

okcrypto_transit_open() now records whether a frame repeats the previous frame's
counter. The host seals every message with the next counter, so a repeat is the
same request sent again; a repeated poll re-serves the chunk it served last.
---
 fido2/ok_extension.cpp | 10 +++++++++-
 onlykey/okcrypto.cpp   | 22 ++++++++++++++++++++++
 onlykey/okcrypto.h     |  1 +
 3 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/fido2/ok_extension.cpp b/fido2/ok_extension.cpp
index 5a4277c..0fdc282 100644
--- a/fido2/ok_extension.cpp
+++ b/fido2/ok_extension.cpp
@@ -115,6 +115,11 @@ extern uint8_t pending_operation;
 extern int packet_buffer_offset;
 extern uint8_t packet_buffer_details[5];
 
+/* Set for a poll whose transit frame repeats the previous frame's counter. The
+ * stored response then serves the chunk it served last instead of the next
+ * one, so the copy the host keeps holds the chunk the first copy consumed. */
+static uint8_t repeated_poll = 0;
+
 // Confirmation for slot-128 shared-secret derives, set by field 30:
 // 0 = challenge code, 1 = button press, 2 = none. The challenge code is
 // bytes 0/15/31 of SHA-256(label hash | input public key), mod 6 (mod 3 on
@@ -391,6 +396,7 @@ int16_t bridge_to_onlykey(uint8_t *_appid, uint8_t *keyh, int handle_len, uint8_
                     return ret;
                 }
                 handle_len = ptlen;
+                repeated_poll = (cmd == OKPING) && okcrypto_transit_repeated();
             }
 #ifdef DEBUG
             Serial.println("Decrypted client handle");
@@ -490,6 +496,8 @@ int16_t bridge_to_onlykey(uint8_t *_appid, uint8_t *keyh, int handle_len, uint8_
 
 int16_t send_stored_response(uint8_t *output, uint8_t opt3) {
     int16_t ret = 0;
+    uint8_t repeat = repeated_poll;
+    repeated_poll = 0;
     if (profilemode != NONENCRYPTEDPROFILE) {
 #ifdef DEBUG
         Serial.print("Sending data on OnlyKey via Webauthn ");
@@ -506,7 +514,7 @@ int16_t send_stored_response(uint8_t *output, uint8_t opt3) {
             ret = CTAP2_ERR_OPERATION_PENDING;
         } else if (large_resp_buffer_offset) {
             int delivered = large_resp_buffer_cursor >= large_resp_buffer_offset;
-            int is_duplicate = delivered || (opt3 && large_resp_buffer_last_opt3 && opt3 <= large_resp_buffer_last_opt3);
+            int is_duplicate = delivered || repeat || (opt3 && large_resp_buffer_last_opt3 && opt3 <= large_resp_buffer_last_opt3);
             int chunk_start = large_resp_buffer_cursor;
             if (is_duplicate && large_resp_buffer_cursor)
                 chunk_start = (large_resp_buffer_cursor - 1) / MAX_LARGE_RESP_CHUNK * MAX_LARGE_RESP_CHUNK;
diff --git a/onlykey/okcrypto.cpp b/onlykey/okcrypto.cpp
index cdce582..4396b81 100644
--- a/onlykey/okcrypto.cpp
+++ b/onlykey/okcrypto.cpp
@@ -1200,8 +1200,25 @@ void crypto_sha512_final(uint8_t *hash) {
  * the tag check. */
 static uint32_t transit_ctr_out = 0; /* device -> host */
 
+/* The counter of the last inbound frame opened, and whether the latest open
+ * carried the same counter as the one before it. */
+static uint32_t transit_ctr_in_last = 0;
+static uint8_t transit_ctr_in_seen = 0;
+static uint8_t transit_ctr_in_repeat = 0;
+
 void okcrypto_transit_reset(void) {
     transit_ctr_out = 0;
+    transit_ctr_in_last = 0;
+    transit_ctr_in_seen = 0;
+    transit_ctr_in_repeat = 0;
+}
+
+/* 1 when the frame just opened repeated the previous frame's counter: the host
+ * sent the same request again rather than a new one. The host seals every
+ * message with the next counter, so a repeat is a re-send of a request already
+ * answered (Windows sends every FIDO2 request twice). */
+int okcrypto_transit_repeated(void) {
+    return transit_ctr_in_repeat;
 }
 
 static void okcrypto_transit_iv(uint8_t *iv, uint8_t dir, uint32_t ctr) {
@@ -1256,6 +1273,7 @@ int okcrypto_transit_open(uint8_t *frame, int len) {
     uint32_t ctr;
     GCM<AES256> gcm;
     int ptlen = len - OKCRYPTO_TRANSIT_OVERHEAD;
+    transit_ctr_in_repeat = 0;
     if (ptlen < 0) {
         memset(frame, 0, len > 0 ? len : 0);
         return -1;
@@ -1273,11 +1291,15 @@ int okcrypto_transit_open(uint8_t *frame, int len) {
         memset(frame, 0, len);
         return -1;
     }
+    transit_ctr_in_repeat = transit_ctr_in_seen && ctr == transit_ctr_in_last;
+    transit_ctr_in_last = ctr;
+    transit_ctr_in_seen = 1;
     memmove(frame, ct, ptlen);
     memset(frame + ptlen, 0, len - ptlen);
 #ifdef DEBUG
     Serial.print("transit open ctr=");
     Serial.print(ctr);
+    Serial.print(transit_ctr_in_repeat ? " repeat" : "");
     Serial.print(" len=");
     Serial.println(ptlen);
 #endif
diff --git a/onlykey/okcrypto.h b/onlykey/okcrypto.h
index d274d2c..263da1c 100644
--- a/onlykey/okcrypto.h
+++ b/onlykey/okcrypto.h
@@ -112,6 +112,7 @@ extern int okcrypto_shared_secret(uint8_t *pub, uint8_t *secret);
 extern void okcrypto_transit_reset(void);
 extern int okcrypto_transit_seal(uint8_t *frame, int len);
 extern int okcrypto_transit_open(uint8_t *frame, int len);
+extern int okcrypto_transit_repeated(void);
 extern void okcrypto_getpubkey(uint8_t *buffer);
 extern void okcrypto_generate_random_key(uint8_t *buffer);
 extern void okcrypto_geteccpubkey(uint8_t *buffer);
-- 
2.55.0


From b5c5709e5d5dc9b7c3a35471bea49a53cd2d11eb Mon Sep 17 00:00:00 2001
From: bmatusiak <bmatusiak@gmail.com>
Date: Thu, 22 Oct 2026 20:21:37 -0400
Subject: [PATCH 2/2] fido2: never act on a repeated data packet

Windows sends every FIDO2 request twice, and the copy of a message's final
packet can arrive after the operation it completed was confirmed. The opt3
duplicate check is reset by that final packet, so the copy started a new
one-packet message whose result replaced the real one (a composite PQC
decrypt from the web app returned an error). A sealed data packet that
repeats the previous frame's counter is now answered as a duplicate.
---
 fido2/ok_extension.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/fido2/ok_extension.cpp b/fido2/ok_extension.cpp
index 0fdc282..1cc1faf 100644
--- a/fido2/ok_extension.cpp
+++ b/fido2/ok_extension.cpp
@@ -397,6 +397,16 @@ int16_t bridge_to_onlykey(uint8_t *_appid, uint8_t *keyh, int handle_len, uint8_
                 }
                 handle_len = ptlen;
                 repeated_poll = (cmd == OKPING) && okcrypto_transit_repeated();
+                if (cmd != OKPING && okcrypto_transit_repeated()) {
+                    // The same data packet again. Acting on it would start a new
+                    // message from this one packet, and when it is the final packet of
+                    // a message already confirmed, its result would replace the real
+                    // one. Answered as the opt3 duplicate check below answers.
+#ifdef DEBUG
+                    Serial.println("Repeated data packet ignored");
+#endif
+                    return 0;
+                }
             }
 #ifdef DEBUG
             Serial.println("Decrypted client handle");
-- 
2.55.0

