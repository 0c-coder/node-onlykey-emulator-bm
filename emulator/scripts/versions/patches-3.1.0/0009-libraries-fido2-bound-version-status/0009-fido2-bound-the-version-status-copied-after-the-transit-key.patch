From d2ef307b4f023c4f4eef104ca01ee1b5c4dfaa6c Mon Sep 17 00:00:00 2001
From: bmatusiak <bmatusiak@gmail.com>
Date: Fri, 23 Oct 2026 06:38:37 -0400
Subject: [PATCH] fido2: bound the version status copied after the transit key

The OKCONNECT reply puts the status (UNLOCKED, the version and the model
letter) after the 32-byte transit key in ecc_public_key, which leaves 33 bytes.
The copy was sized by the string, so a version name longer than 23 characters
wrote past the buffer - 4 bytes with the test hex keyword
-test-9fceea1-37aa531. The copy is now bounded by the room left; a name that
does not fit is cut, as the copy of the buffer into the reply already cuts it.
---
 fido2/ok_extension.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/fido2/ok_extension.cpp b/fido2/ok_extension.cpp
index 1cc1faf..5e3eac0 100644
--- a/fido2/ok_extension.cpp
+++ b/fido2/ok_extension.cpp
@@ -213,7 +213,16 @@ int16_t bridge_to_onlykey(uint8_t *_appid, uint8_t *keyh, int handle_len, uint8_
             Serial.println("OnlyKey public = ");
             byteprint(ecc_public_key, 32);
 #endif
-            memcpy(ecc_public_key + 32, HW_MODEL(UNLOCKED), sizeof(UNLOCKED) + 1);
+            {
+                // The status follows the key, bounded by the room left in ecc_public_key:
+                // a version name longer than that is cut here, as the copy into temp
+                // below cuts it.
+                const char *status = HW_MODEL(UNLOCKED);
+                size_t len = strlen(status) + 1;
+                const size_t room = sizeof(ecc_public_key) - 32;
+                if (len > room) len = room;
+                memcpy(ecc_public_key + 32, status, len);
+            }
             // Response goes out via WEBAUTHN
             outputmode = WEBAUTHN;
             memcpy(temp, ecc_public_key, sizeof(ecc_public_key)); //Store OnlyKey public NACL transit key (includes OnlyKey version info)
