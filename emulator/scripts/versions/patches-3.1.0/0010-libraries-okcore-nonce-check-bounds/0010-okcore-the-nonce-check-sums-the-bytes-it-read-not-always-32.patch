From 2ce5fcecf2d5ffa85e112842df19a5b0666eceeb Mon Sep 17 00:00:00 2001
From: bmatusiak <bmatusiak@gmail.com>
Date: Fri, 23 Oct 2026 08:24:04 -0400
Subject: [PATCH] okcore: the nonce check sums the bytes it read, not always 32

okcore_flashget_noncehash(ptr, size) reads size bytes into ptr but summed 32
of them to decide whether a nonce is set. okcrypto_aes_gcm_encrypt() and
okcrypto_aes_gcm_decrypt() pass a 12-byte stack buffer, so every call read
20 bytes past it (AddressSanitizer: stack-buffer-overflow READ, on each PIN
set). The sum now covers size bytes and is compared with 0xFF * size; the
callers that pass 32 get exactly the old check.
---
 onlykey/okcore.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/onlykey/okcore.cpp b/onlykey/okcore.cpp
index 14f5dd1..b94f96e 100644
--- a/onlykey/okcore.cpp
+++ b/onlykey/okcore.cpp
@@ -2951,13 +2951,14 @@ int okcore_flashget_noncehash(uint8_t *ptr, int size) {
     Serial.println("Reading nonce");
 #endif
     okcore_flashget_common(ptr, (unsigned long *)adr, size);
-    for (int i = 0; i < 32; i++) {
+    // Only the size bytes read into ptr: callers pass 12-byte buffers as well as 32-byte ones.
+    for (int i = 0; i < size; i++) {
         set = *(ptr + i) + set;
     }
 #ifdef DEBUG
     Serial.println(set);
 #endif
-    if (set == 8160) { //0xFF * 32
+    if (set == 0xFF * size) { // every byte read is 0xFF: the sector was never written
 #ifdef DEBUG
         Serial.println("There is no Nonce hash set");
 #endif
-- 
2.55.0

