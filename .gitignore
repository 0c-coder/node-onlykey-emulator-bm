node_modules

# --- emulator build output -------------------------------------------------
# .stage/ is the assembled compile tree: copies of the teensy3 core, OnlyKey's
# libraries and the sketch, with our overrides and patches layered on top.
# Regenerate with `npm run stage` in emulator/ - never edit it directly, edit
# emulator/core-override/ or the PATCHES list in scripts/stage.js instead.
emulator/.stage/
# .stage-src/<version>/ holds released firmware trees unpacked from git by
# OKEMU_VERSION staging (~6 MB each) - rebuilt from the pinned commits on demand.
emulator/.stage-src/
# .stage-identity-node / -android record what the last stage of each kind of build was (version,
# target, gates, plugins); scripts/stage.js drops that kind's compiled objects when it changes.
emulator/.stage-identity*
# .matrix/ keeps each release's build log from scripts/matrix.js.
emulator/.matrix/

# node-gyp output
emulator/build/
build/Release/
build/Debug/
*.node
*.o
*.a

# generated file list (produced by scripts/gen-sources.js)
emulator/sources.gypi

# --- out-of-tree kernel module ---------------------------------------------
# dummy_hcd is the virtual USB Device Controller the gadget transport binds to.
# Ubuntu ships `# CONFIG_USB_DUMMY_HCD is not set`, so it is compiled locally by
# scripts/build-dummy-hcd.sh from linux-source. Everything here is generated and
# tied to one exact kernel release - rebuild rather than commit it.
build/
*.ko
*.ko.cmd
*.mod
*.mod.c
*.symvers
*.order
.tmp_versions/

# --- emulated device state -------------------------------------------------
# Simulated flash / EEPROM images. These are the emulated OnlyKey's persistent
# storage - device keys, PINs and slot data live here, so they are both
# machine-specific and sensitive.
*.onlykey-storage/
.onlykey-storage/
flash.bin
eeprom.bin

# --- misc ------------------------------------------------------------------
npm-debug.log*
.DS_Store


# a patch bundled for the maintainer is sent, not kept: the .patch beside it is the source
emulator/scripts/versions/patches-*/**/*.tar.gz
